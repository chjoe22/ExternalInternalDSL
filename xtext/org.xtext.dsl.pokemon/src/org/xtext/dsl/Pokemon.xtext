grammar org.xtext.dsl.Pokemon with org.eclipse.xtext.common.Terminals

generate pokemon "http://www.xtext.org/dsl/Pokemon"

Model:
    ( players+=Player | explore+=Explore | pokemon+=PokemonDef | move+=Move | trainer+=Trainer)* 
;
    
Player:
    'player' name=ID '{' 
        'money' money=Exp
        'badges' badges=INT 
        'party' '(' team+=PokemonInstance (',' team+=PokemonInstance)* ')' 
    '}'
; 

Trainer:
    'trainer' name=ID '{' 
    	('difficulty' difficulty=TrainerType)?
    	('requires' req=Exp)?
        'party' '(' team+=PokemonInstance (',' team+=PokemonInstance)* ')' 
    '}'
;

PokemonDef:
    (isWild?='wild')? 'pokemon' name=ID '{' 
        (('hp' hp=Exp) &
        ('attack' attack=Exp) &
        ('defense' defense=Exp) &
        ('sp.atk' spatk=Exp) &
        ('sp.def' spdef=Exp) &
        ('speed' speed=Exp)) 
        'type' type=ElementalType
        'move' '(' moves+=[Move] (',' moves+=[Move])* ')'
    '}'
;

PokemonInstance:
    species=[PokemonDef] 'lvl' level=INT
;

Exp:
    Or
;

Or returns Exp:
	And ({Or.left=current} op='||' right=And)*
;

And returns Exp:
	Equal ({And.left=current} op='&&' right=Equal)*
;

Equal returns Exp:
	Comparison ({Equal.left=current} op=('=='|'!=') right=Comparison)?
;

Comparison returns Exp:
	Addition ({Comparison.left=current} op=('>='|'<='|'<'|'>') right=Addition)?
;

Addition returns Exp:
    Multiplication ({Addition.left=current} op=('+'|'-') right=Multiplication)*
;

Multiplication returns Exp:
    Primary ({Multiplication.left=current} op=('*'|'/') right=Primary)*
;

Primary returns Exp:
    BoolVal | NumVal | FloatVal | LvlRef | BadgeRef | '(' Exp ')'
;

BoolVal returns Exp:
	{BoolVal} value=('true'|'false')
;

NumVal returns Exp:
    {NumVal} value=INT
;

FloatVal returns Exp:
	{FloatVal} value=DECIMAL
;

LvlRef returns Exp:
    {LvlRef} 'lvl'
;

BadgeRef returns Exp:
	{BadgeRef} 'badges'
;

terminal DECIMAL:
	INT '.' INT
;

Action:
    'action' name=ActionType ('->' 'outcome' ':' description=STRING)?
;

Move:
    'move' name=ID 'type' type=ElementalType 'power' power=INT 'accuracy' acc=INT 'pp' pp=INT
;

Explore:
    'explore' '{' routes+=Route+ '}'
;

Route:
    'route' name=ID
    'type' type=RouteType
    (description=STRING)?
    '{'
        events+=Event*
        ('exits' '(' exits+=[Route] (',' exits+=[Route])* ')')?
    '}'
;

enum RouteType:
    town | cave | wilderness | road
;

enum ElementalType:
	FIRE | WATER | ELECTRIC | POISON | NORMAL | FIGHTING
;

enum ActionType:
	ATTACK | CATCH | FLEE
;

enum TrainerType:
	Normal | Rival | GymLeader | EliteFour | Champion
;

Event:
    WildEncounter | TrainerBattle | RandomItem | HealingCenter
;

WildEncounter:
    {WildEncounter} 'encounter' name=ID 'wild' 'pokemon' pokemon=PokemonInstance (catchable?='catchable')? '{'
        (actions+=Action)*
        ('win'  'goto' winNext=[Route])?
        ('lose' 'goto' loseNext=[Route])?
    '}'
;

TrainerBattle:
    {TrainerBattle} 'battle' name=ID 'vs' opponent=[Trainer] '{'
        ('win'  'goto' winNext=[Route])?
        ('lose' 'goto' loseNext=[Route])?
        ('reward' reward=BattleReward)?
    '}'
;

BattleReward:
	'badges' badges=INT
;

RandomItem:
    {RandomItem} 'random_item' name=ID 'found' quantity=INT description=STRING
    ('then' 'goto' next=[Route])?
;

HealingCenter:
    {HealingCenter} 'heal' name=ID 'at' description=STRING
    ('then' 'goto' next=[Route])?
;